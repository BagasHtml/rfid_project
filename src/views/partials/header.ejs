<% const titles = { index: 'Absensi', register: 'Daftar Kartu', students: 'Daftar Siswa', kelas: 'Absensi Kelas', login: 'Masuk' }; %>
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <img src="/images/logo.webp" width="" alt="SMK Taruna Bangsa" class="sidebar-logo">
    </div>

    <nav class="sidebar-nav">
      <% if (user && user.role === 'admin') { %>
        <span class="nav-category">Menu</span>
        <a href="/" class="nav-item <%= page === 'index' ? 'active' : '' %>">
          <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          <span>Absensi</span>
        </a>
        <a href="/register" class="nav-item <%= page === 'register' ? 'active' : '' %>">
          <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 9.75a6 6 0 0 1 11.573-2.226 3.75 3.75 0 0 1 4.133 5.512M19.5 21v-5.25M19.5 12.75v.75M5.25 21v-3a6.75 6.75 0 0 1 6.75-6.75 6.7 6.7 0 0 1 3.57 1.05"/></svg>
          <span>Daftar Kartu</span>
        </a>
        <a href="/students" class="nav-item <%= page === 'students' ? 'active' : '' %>">
          <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>
          <span>Daftar Siswa</span>
        </a>
      <% } else if (user && user.role === 'class') { %>
        <span class="nav-category">Menu</span>
        <a href="/kelas/<%= encodeURIComponent(user.class) %>" class="nav-item <%= page === 'kelas' ? 'active' : '' %>">
          <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          <span>Absensi Kelas</span>
        </a>
      <% } %>
    </nav>

    <div class="sidebar-promo">
      <div class="promo-card">
        <span class="promo-label">Sistem Absensi</span>
        <strong class="promo-title">SMK Taruna Bangsa</strong>
        <% if (user && user.role === 'admin') { %>
          <a href="/" class="promo-link">Kembali ke Absensi &rsaquo;</a>
        <% } else if (user && user.role === 'class') { %>
          <a href="/kelas/<%= encodeURIComponent(user.class) %>" class="promo-link">Kembali ke Absensi Kelas &rsaquo;</a>
        <% } %>
      </div>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <div class="topbar-greeting">
        <h1 class="topbar-title"><%= titles[page] || 'Absensi' %></h1>
        <span class="topbar-date" id="current-date"></span>
      </div>
      <div class="topbar-actions">
        <% if (user && (page === 'index' || page === 'kelas')) { %>
          <div class="connection-pill" id="connection-status">
            <span class="status-dot disconnected"></span>
            <span class="status-text">Terputus</span>
          </div>
        <% } %>
        <% if (user) { %>
          <div class="user-pill">
            <span class="user-pill-role"><%= user.role === 'admin' ? 'Admin' : user.class %></span>
            <span class="user-pill-name"><%= user.username %></span>
          </div>
          <button type="button" class="btn-secondary btn-sm logout-btn" id="logout-btn">Keluar</button>
        <% } %>
      </div>
    </header>
    <main class="container">
